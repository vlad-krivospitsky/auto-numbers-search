# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# Секретный ключ Django. Сгенерируйте новый командой:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Режим отладки: True только для локальной разработки, False в production
DEBUG=True

# Список разрешённых хостов через запятую (без пробелов)
# Локально: 127.0.0.1,localhost
# Production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost

# API-ключ для carimagesapi.com (изображения автомобилей)
CAR_IMAGES_API_KEY=your-carimagesapi-key-here
